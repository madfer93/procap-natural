# Procap Natural - Environment Variables

# Groq AI API Key
GROQ_API_KEY=your_groq_api_key_here

# Supabase Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Cloudflare R2 Object Storage (Almacenamiento de Videos e Imágenes)
CLOUDFLARE_R2_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_BUCKET_NAME=procap-natural
CLOUDFLARE_R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# Pasarelas de Pago Colombia
WOMPI_PUBLIC_KEY=pub_prod_xxxxxxxxxxxxxxxxx
WOMPI_INTEGRITY_SECRET=prod_integrity_xxxxxxxxxxxxx
WOMPI_EVENTS_SECRET=your_wompi_events_secret

# Admin Security PIN
ADMIN_ACCESS_PIN=your_secure_admin_pin

# Contact & URLs
NEXT_PUBLIC_WHATSAPP_NUMBER=573151189795
NEXT_PUBLIC_SITE_URL=https://protesiscapilarcolombia.com
